
DECLARE serviceNS NAMESPACE 'http://example.com/userservice';

CREATE COMPUTE MODULE UserServiceProvider_CreateUser
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		CALL CopyMessageHeaders();
		
		DECLARE createUserRequestRef REFERENCE TO InputRoot.XMLNSC.serviceNS:CreateUserRequest;
		
		DECLARE temp ROW;
		SET temp.Result[] = PASSTHRU('SELECT users_id_seq.NEXTVAL AS user_id FROM dual');
		DECLARE userID INTEGER CAST(FIELDVALUE(temp.Result.USER_ID) AS INTEGER);
		
		INSERT INTO Database.users (id, name, role)
		VALUES (userID, createUserRequestRef.name, createUserRequestRef.role);
		
		SET OutputRoot.XMLNSC.serviceNS:CreateUserResponse.id = userID;
		
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
