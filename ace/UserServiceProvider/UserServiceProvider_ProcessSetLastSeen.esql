

CREATE COMPUTE MODULE UserServiceProvider_ProcessSetLastSeen
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		DECLARE setLastSeenRequestRef REFERENCE TO InputRoot.XMLNSC.serviceNS:SetLastSeenRequest;
		
		UPDATE Database.USERS AS U
		SET LAST_SEEN = CAST(setLastSeenRequestRef.lastSeen AS CHARACTER FORMAT 'yyyy-MM-dd HH:mm:ss.SS ZZZ')
		WHERE U.ID = setLastSeenRequestRef.id;
		
		RETURN FALSE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

	CREATE PROCEDURE CopyEntireMessage() BEGIN
		SET OutputRoot = InputRoot;
	END;
END MODULE;
