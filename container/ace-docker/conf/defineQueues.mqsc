DEFINE CHANNEL(ADMIN_SVRCONN) CHLTYPE(SVRCONN) MCAUSER('mqsi') REPLACE

DEFINE QLOCAL('DLQ') DEFPSIST(YES) MAXDEPTH(999999999) REPLACE
ALTER QMGR DEADQ('DLQ')

DEFINE QLOCAL('MONITORING_EVENTS') DEFPSIST(NO) MAXDEPTH(999999999)
DEFINE TOPIC ('MONITORING_EVENTS') TYPE(LOCAL) TOPICSTR('$SYS/Broker/+/MonitoringEvents/#')
DEFINE SUB ('MONITORING_EVENTS_SUB') DEST('MONITORING_EVENTS') TOPICOBJ('MONITORING_EVENTS')

DEFINE QLOCAL('TEST_IN') DEFPSIST(NO) MAXDEPTH(999999999) REPLACE
DEFINE QLOCAL('TEST_IN1') DEFPSIST(NO) MAXDEPTH(999999999) REPLACE
DEFINE QLOCAL('TEST_OUT') DEFPSIST(NO) MAXDEPTH(999999999) REPLACE
DEFINE QLOCAL('TEST_OUT1') DEFPSIST(NO) MAXDEPTH(999999999) REPLACE
